################################################################################
# Pipeline scratch
################################################################################
# Staging copy of data/raw_mave_data/, mounted into the variant-annotation
# container as VARIANT_DATA_DIR -- regenerated by
# scripts/run_variant_annotation_pipeline.sh on every run.
data/intermediate/

# Generated/large data directories -- kept as empty folders in git via a
# .gitkeep placeholder so the expected paths exist on a fresh clone, but their
# actual contents (regenerated or hand-supplied locally) aren't tracked.
data/mave_calibration/*
!data/mave_calibration/excalibr/
data/mave_calibration/excalibr/*
!data/mave_calibration/excalibr/.gitkeep

data/mave_data/*
!data/mave_data/.gitkeep

data/supplementary_data/*
!data/supplementary_data/.gitkeep
